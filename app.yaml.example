# Modelo do app.yaml (o app.yaml de verdade tem segredos e fica fora do Git).
# Copie para app.yaml e preencha os valores. Passo a passo em docs/deploy.md.
runtime: python312

entrypoint: gunicorn -b :$PORT --workers 1 --threads 4 naes2026.wsgi

handlers:
- url: /static
  static_dir: static_gcloud/
- url: /.*
  script: auto
  secure: always

automatic_scaling:
  min_instances: 0
  max_instances: 2

env_variables:
  DJANGO_SETTINGS_MODULE: "naes2026.settings"
  DEBUG: "False"
  SECRET_KEY: "<gere com: python -c \"import secrets; print(secrets.token_urlsafe(50))\">"
  ALLOWED_HOSTS: "*"
  CSRF_TRUSTED_ORIGINS: "https://<projeto>.rj.r.appspot.com"
  DATABASE_URL: "postgresql://<usuario>:<senha>@<host>/<banco>?sslmode=require"
  GEMINI_API_KEY: "<chave do Google AI Studio>"
