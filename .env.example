# Copie este arquivo para ".env" e preencha os valores.
# O ".env" está no .gitignore e NUNCA deve ser commitado.
# Em produção, as mesmas variáveis vão no env_variables do app.yaml.

# --- Django ---
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Separadas por vírgula, com o esquema. Ex.: https://meusite.rj.r.appspot.com
CSRF_TRUSTED_ORIGINS=

# --- Banco (vazio = SQLite local) ---
# Ex.: postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL=

# --- IA (Google Gemini) — crie a chave em https://aistudio.google.com/apikey ---
GEMINI_API_KEY=

# --- Opcionais: Gemini pela identidade do App Engine (Vertex AI), sem API Key ---
# GEMINI_USAR_VERTEX=False
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
